{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ExplainCode",
  "scopeName": "source.explaincode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#step_prefix"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.explaincode",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.explaincode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.explaincode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.explaincode",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.explaincode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.explaincode",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "step_prefix": {
      "patterns": [
        {
          "name": "keyword.other.step.explaincode",
          "match": "\\bSTEP\\s+\\d+:?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.explaincode",
          "match": "\\b(ALGORITHM|MODEL|API_CALL|END ALGORITHM|END MODEL|END API_CALL)\\b"
        },
        {
          "name": "keyword.other.io.explaincode",
          "match": "\\b(INPUT:|OUTPUT:|KEY:)\\b"
        },
        {
          "name": "keyword.control.conditional.explaincode",
          "match": "\\b(IF|THEN|ELSE|END IF)\\b"
        },
        {
          "name": "keyword.control.loop.explaincode",
          "match": "\\b(FOR|FOREACH|IN|to|DO|END FOR|END FOREACH|WHILE|END WHILE|BREAK|CONTINUE)\\b"
        },
        {
          "name": "keyword.control.exception.explaincode",
          "match": "\\b(TRY|CATCH|END TRY)\\b"
        },
        {
          "name": "keyword.other.action.explaincode",
          "match": "\\b(Set|SET|PRINT|DISPLAY|RETURN|Import|CALL|CREATE)\\b"
        },
        {
          "name": "keyword.other.datastructure.explaincode",
          "match": "\\b(LIST|DICT|APPEND|REMOVE|GET)\\b"
        },
        {
          "name": "keyword.other.functional.explaincode",
          "match": "\\b(SORT|FILTER|WHERE|MAP|WITH|REDUCE)\\b"
        },
        {
          "name": "keyword.other.ai.explaincode",
          "match": "\\b(LOAD_MODEL|PREDICT|TRAIN|ON)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.explaincode",
          "match": "=="
        },
        {
          "name": "keyword.operator.arrow.explaincode",
          "match": "→"
        },
        {
          "name": "keyword.operator.comparison.explaincode",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.explaincode",
          "match": "(\\+|\\-|\\*|/|%|\\*\\*)"
        }
      ]
    }
  }
}
